###  http://open-model.eu/ontologies/ss5#Catalyst
:Catalyst rdf:type owl:Class ;
          rdfs:subClassOf emmo:EMMO_a96e2152_40e7_409c_a53a_fdb9f141eb6a ;
          skos:prefLabel "Catalyst"@en ;
          emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "A catalyst is a substance that speeds up a chemical reaction without being consumed in the process."@en .


###  http://open-model.eu/ontologies/ss5#CatalystDevice
:CatalystDevice rdf:type owl:Class ;
                rdfs:subClassOf emmo:EMMO_494b372c_cfdf_47d3_a4de_5e037c540de8 ;
                skos:prefLabel "CatalystDevice"@en ;
                emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "A device supporting a catalytic driven process."@en .


###  http://open-model.eu/ontologies/ss5#CatalystSupport
:CatalystSupport rdf:type owl:Class ;
                 rdfs:subClassOf emmo:EMMO_86ca9b93_1183_4b65_81b8_c0fcd3bba5ad ;
                 skos:altLabel "Washcoat"@en ;
                 skos:prefLabel "CatalystSupport"@en ;
                 emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "The support material for the catalyst in a EAT device"@en .


###  http://open-model.eu/ontologies/ss5#Driving
:Driving rdf:type owl:Class ;
         rdfs:subClassOf emmo:EMMO_43e9a05d_98af_41b4_92f6_00f79a09bfce ;
         skos:prefLabel "Driving"@en ;
         emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "Driving is the act of operating and controlling a vehicle, typically a motor vehicle such as a car, truck, or bus, to transport people or goods from one location to another."@en .


###  http://open-model.eu/ontologies/ss5#EATDevice
:EATDevice rdf:type owl:Class ;
           rdfs:subClassOf emmo:EMMO_494b372c_cfdf_47d3_a4de_5e037c540de8 ;
           skos:altLabel "ExhaustAfterTreatment"@en ;
           skos:prefLabel "EATDevice"@en ;
           emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "An exhaust after-treatment device is a component in a vehicle's exhaust system designed to reduce harmful emissions before they are released into the atmosphere. These devices help comply with environmental regulations by minimizing pollutants like nitrogen oxides (NOx), carbon monoxide (CO), hydrocarbons (HC), and particulate matter (PM)."@en .


###  http://open-model.eu/ontologies/ss5#Engine
:Engine rdf:type owl:Class ;
        rdfs:subClassOf emmo:EMMO_494b372c_cfdf_47d3_a4de_5e037c540de8 ;
        skos:prefLabel "Engine"@en ;
        emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "An engine is a machine designed to convert energy into mechanical motion or power. It typically uses fuel or other energy sources to create movement, which can then be used to propel vehicles, operate machinery, or generate electricity."@en .


###  http://open-model.eu/ontologies/ss5#Fuel
:Fuel rdf:type owl:Class ;
      rdfs:subClassOf emmo:EMMO_8820f251_ad36_43f4_a693_c0e86a89cc1f ;
      skos:prefLabel "Fuel"@en ;
      emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "A fuel is any material that can be made to react with other substances so that it releases energy as thermal energy or to be used for work."@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Fuel ;
   owl:annotatedProperty emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 ;
   owl:annotatedTarget "A fuel is any material that can be made to react with other substances so that it releases energy as thermal energy or to be used for work."@en ;
   emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d <https://en.wikipedia.org/wiki/Fuel>
 ] .


###  http://open-model.eu/ontologies/ss5#Vehicle
:Vehicle rdf:type owl:Class ;
         rdfs:subClassOf emmo:EMMO_86ca9b93_1183_4b65_81b8_c0fcd3bba5ad ;
         skos:prefLabel "Vehicle"@en ;
         emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "A machine, usually with wheels and an engine, used for transporting people or goods, especially on land."@en .


